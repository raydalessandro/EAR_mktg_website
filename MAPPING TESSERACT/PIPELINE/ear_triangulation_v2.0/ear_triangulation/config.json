{
  "llm": {
    "provider": "deepseek",
    "api_key": "YOUR_DEEPSEEK_API_KEY",
    "model": "deepseek-chat"
  },
  "documents": {
    "rules": "data/EAR_MAPPING_RULES_v1.2.md",
    "kernel": "data/EAR_NANO_KERNEL_AILA_v1_0.md",
    "archetypes": "data/EAR_ARCHETYPES_72.md"
  },
  "output_dir": "results",
  "review_dir": "results/review",
  "network_path": "data/network_state.json",
  "backup_dir": "data/backups",
  "verbose": true,

  "_examples": {
    "_claude": {
      "provider": "claude",
      "api_key": "sk-ant-...",
      "model": "claude-sonnet-4-20250514"
    },
    "_ollama": {
      "provider": "ollama",
      "model": "qwen2.5:3b"
    },
    "_ollama_remote": {
      "provider": "ollama",
      "model": "qwen2.5:3b",
      "base_url": "http://your-server:11434"
    },
    "_openai_compatible": {
      "provider": "openai",
      "base_url": "http://localhost:8000",
      "model": "your-model",
      "api_key": ""
    }
  }
}
